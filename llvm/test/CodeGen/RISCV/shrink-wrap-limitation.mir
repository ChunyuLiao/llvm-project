  ; COPY-COMBINE-INST-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY [[COPY1]]
  ; COPY-COMBINE-INST-NEXT:   [[ADDI:%[0-9]+]]:gpr = ADDI $x0, 57
  ; COPY-COMBINE-INST-NEXT:   BEQ [[COPY]], killed [[ADDI]], %bb.4
