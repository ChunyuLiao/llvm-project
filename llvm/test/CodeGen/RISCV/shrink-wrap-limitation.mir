--- |
  ; ModuleID = 'shrink-wrap-limitation.ll'
  source_filename = "shrink-wrap-limitation.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64"

  define void @li_straightline_b(i32 zeroext %a, i32 zeroext %b) {
    %cmp0 = icmp eq i32 %b, 57
    br i1 %cmp0, label %exit, label %do_call

  do_call:                                          ; preds = %0
    %1 = call i32 @foo()
    br label %next

  next:                                             ; preds = %do_call
    %cmp1 = icmp eq i32 %a, 57
    br i1 %cmp1, label %exit, label %do_call2

  do_call2:                                         ; preds = %next
    %2 = call i32 @foo()
    br label %exit

  exit:                                             ; preds = %do_call2, %next, %0
    ret void
  }

  declare zeroext i32 @foo()
...
