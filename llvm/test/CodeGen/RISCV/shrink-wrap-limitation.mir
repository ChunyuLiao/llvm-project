  ; COPY-COMBINE-INST-NEXT:   BEQ [[COPY2]], killed [[ADDI1]], %bb.4
  ; COPY-COMBINE-INST-NEXT:   PseudoBR %bb.3
  ; COPY-COMBINE-INST-NEXT: {{  $}}
  ; COPY-COMBINE-INST-NEXT: bb.3.do_call2:
  ; COPY-COMBINE-INST-NEXT:   successors: %bb.4(0x80000000)
  ; COPY-COMBINE-INST-NEXT: {{  $}}
  ; COPY-COMBINE-INST-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; COPY-COMBINE-INST-NEXT:   PseudoCALL target-flags(riscv-call) @foo, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2, implicit-def $x10
  ; COPY-COMBINE-INST-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; COPY-COMBINE-INST-NEXT:   [[COPY4:%[0-9]+]]:gpr = COPY $x10
  ; COPY-COMBINE-INST-NEXT: {{  $}}
  ; COPY-COMBINE-INST-NEXT: bb.4.exit:
  ; COPY-COMBINE-INST-NEXT:   PseudoRET
  bb.0 (%ir-block.0):
    successors: %bb.4(0x40000000), %bb.1(0x40000000)
    liveins: $x10, $x11

    %1:gpr = COPY $x11
    %0:gpr = COPY $x10
    INLINEASM &"#lw0", 1 /* sideeffect attdialect */, 12 /* clobber */, implicit-def early-clobber $x10, 12 /* clobber */, implicit-def early-clobber $x22
    %2:gpr = COPY %0
    %3:gpr = ADDI $x0, 57
    BEQ %1, killed %3, %bb.4
    PseudoBR %bb.1

  bb.1.do_call:
    successors: %bb.2(0x80000000)

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @foo, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %4:gpr = COPY $x10

  bb.2.next:
    successors: %bb.4(0x40000000), %bb.3(0x40000000)

    %5:gpr = ADDI $x0, 57
    BEQ %2, killed %5, %bb.4
    PseudoBR %bb.3

  bb.3.do_call2:
    successors: %bb.4(0x80000000)

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @foo, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %6:gpr = COPY $x10

  bb.4.exit:
    PseudoRET
